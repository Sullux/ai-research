#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
} pc;

layout(std430, binding = 0) readonly buffer WBuf { uint W[]; };
layout(std430, binding = 1) readonly buffer XBuf { float X[]; };
layout(std430, binding = 2) writeonly buffer YBuf { float Y[]; };

void main() {
    uint local_row = gl_LocalInvocationID.x >> 5;
    uint lane = gl_LocalInvocationID.x & 31;
    uint row = gl_WorkGroupID.x * 4 + local_row;

    float acc = 1.0;
    float sum = subgroupAdd(acc);

    if (lane == 0 && row < pc.M) {
        Y[row] = sum;
    }
}
